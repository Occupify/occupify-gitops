[Unit]
Description=Occupify Notification Service
After=network-online.target occupify-infra-noti.service
Wants=occupify-infra-noti.service

[Service]
Restart=always
EnvironmentFile=%h/.config/systemd/user/git-ops/env/noti.env
WorkingDirectory=%h/.config/systemd/user/git-ops

ExecStart=/usr/bin/podman-compose -p occupify-be-noti -f services/noti/compose.prod.yml --env-file env/noti.env up
ExecStop=/usr/bin/podman-compose -p occupify-be-noti -f services/noti/compose.prod.yml --env-file env/noti.env down

[Install]
WantedBy=default.target
