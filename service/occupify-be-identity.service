[Unit]
Description=Occupify Identity & Auth Service
After=network-online.target
Wants=network-online.target

[Service]
Restart=always
EnvironmentFile=%h/.config/systemd/user/git-ops/env/identity.env
WorkingDirectory=%h/.config/systemd/user/git-ops

ExecStart=/usr/bin/podman-compose -p occupify-be-identity -f compose/docker.be.identity.compose.yml --env-file env/identity.env up
ExecStop=/usr/bin/podman-compose -p occupify-be-identity -f compose/docker.be.identity.compose.yml --env-file env/identity.env down

[Install]
WantedBy=default.target