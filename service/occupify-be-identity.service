[Unit]
Description=Occupify Identity & Auth Service
After=network-online.target occupify-infra-identity.service
Wants=occupify-infra-identity.service

[Service]
Restart=always
EnvironmentFile=%h/.config/systemd/user/git-ops/env/identity.env
WorkingDirectory=%h/.config/systemd/user/git-ops

ExecStart=/usr/bin/podman-compose -p occupify-be-identity -f services/identity/compose.prod.yml --env-file env/identity.env up
ExecStop=/usr/bin/podman-compose -p occupify-be-identity -f services/identity/compose.prod.yml --env-file env/identity.env down

[Install]
WantedBy=default.target
