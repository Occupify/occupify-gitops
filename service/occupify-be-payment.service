[Unit]
Description=Occupify Payment Service
After=network-online.target occupify-infra-payment.service
Wants=occupify-infra-payment.service

[Service]
Restart=always
EnvironmentFile=%h/.config/systemd/user/git-ops/env/payment.env
WorkingDirectory=%h/.config/systemd/user/git-ops

ExecStart=/usr/bin/podman-compose -p occupify-be-payment -f services/payment/compose.prod.yml --env-file env/payment.env up
ExecStop=/usr/bin/podman-compose -p occupify-be-payment -f services/payment/compose.prod.yml --env-file env/payment.env down

[Install]
WantedBy=default.target
