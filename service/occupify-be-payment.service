[Unit]
Description=Occupify Payment Service
After=network-online.target
Wants=network-online.target

[Service]
Restart=always
EnvironmentFile=%h/.config/systemd/user/git-ops/payment.env
WorkingDirectory=%h/.config/systemd/user/git-ops

ExecStart=/usr/bin/podman-compose -p occupify-be-payment -f docker.be.payment.compose.yml --env-file payment.env up
ExecStop=/usr/bin/podman-compose -p occupify-be-payment -f docker.be.payment.compose.yml --env-file payment.env down

[Install]
WantedBy=default.target