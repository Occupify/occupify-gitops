[Unit]
Description=Occupify Notification Infrastructure (Postgres)
After=network-online.target
Wants=network-online.target

[Service]
Restart=always
WorkingDirectory=%h/.config/systemd/user/git-ops

ExecStart=/usr/bin/podman-compose -p occupify-infra-noti -f services/noti/compose.infra.yml --env-file env/infra.env up
ExecStop=/usr/bin/podman-compose -p occupify-infra-noti -f services/noti/compose.infra.yml --env-file env/infra.env down

[Install]
WantedBy=default.target
