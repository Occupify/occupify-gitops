[Unit]
Description=Occupify API Gateway Service
After=network-online.target
Wants=network-online.target

[Service]
Restart=always
EnvironmentFile=%h/.config/systemd/user/git-ops/gateway.env
WorkingDirectory=%h/.config/systemd/user/git-ops

ExecStart=/usr/bin/podman-compose -p occupify-be-gateway -f docker.be.gateway.compose.yml --env-file gateway.env up
ExecStop=/usr/bin/podman-compose -p occupify-be-gateway -f docker.be.gateway.compose.yml --env-file gateway.env down

[Install]
WantedBy=default.target