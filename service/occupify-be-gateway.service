[Unit]
Description=Occupify API Gateway Service
After=network-online.target occupify-infra-shared.service
Wants=occupify-infra-shared.service

[Service]
Restart=always
EnvironmentFile=%h/.config/systemd/user/git-ops/env/gateway.env
WorkingDirectory=%h/.config/systemd/user/git-ops

ExecStart=/usr/bin/podman-compose -p occupify-be-gateway -f compose/gateway/compose.prod.yml --env-file env/gateway.env up
ExecStop=/usr/bin/podman-compose -p occupify-be-gateway -f compose/gateway/compose.prod.yml --env-file env/gateway.env down

[Install]
WantedBy=default.target
