[Unit]
Description=Occupify Agentic Service
After=network-online.target occupify-infra-agentic.service
Wants=occupify-infra-agentic.service

[Service]
Restart=always
EnvironmentFile=%h/.config/systemd/user/git-ops/env/agentic.env
WorkingDirectory=%h/.config/systemd/user/git-ops

ExecStart=/usr/bin/podman-compose -p occupify-be-agentic -f compose/agentic/compose.prod.yml --env-file env/agentic.env up
ExecStop=/usr/bin/podman-compose -p occupify-be-agentic -f compose/agentic/compose.prod.yml --env-file env/agentic.env down

[Install]
WantedBy=default.target
