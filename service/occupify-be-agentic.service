[Unit]
Description=Occupify Agentic Service
After=network-online.target
Wants=network-online.target

[Service]
Restart=always
EnvironmentFile=%h/.config/systemd/user/git-ops/env/agentic.env
WorkingDirectory=%h/.config/systemd/user/git-ops

ExecStart=/usr/bin/podman-compose -p occupify-be-agentic -f compose/docker.be.agentic.compose.yml --env-file env/agentic.env up
ExecStop=/usr/bin/podman-compose -p occupify-be-agentic -f compose/docker.be.agentic.compose.yml --env-file env/agentic.env down

[Install]
WantedBy=default.target
