[Unit]
Description=Occupify Core Marketplace Service
After=network-online.target
Wants=network-online.target

[Service]
Restart=always
EnvironmentFile=%h/.config/systemd/user/git-ops/env/core.env
WorkingDirectory=%h/.config/systemd/user/git-ops

ExecStart=/usr/bin/podman-compose -p occupify-be-core -f compose/docker.be.core.compose.yml --env-file env/core.env up
ExecStop=/usr/bin/podman-compose -p occupify-be-core -f compose/docker.be.core.compose.yml --env-file env/core.env down

[Install]
WantedBy=default.target