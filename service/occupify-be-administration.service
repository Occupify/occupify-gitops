[Unit]
Description=Occupify Administration Service
After=network-online.target
Wants=network-online.target

[Service]
Restart=always
EnvironmentFile=%h/.config/systemd/user/git-ops/administration.env
WorkingDirectory=%h/.config/systemd/user/git-ops

ExecStart=/usr/bin/podman-compose -p occupify-be-administration -f docker.be.administration.compose.yml --env-file administration.env up
ExecStop=/usr/bin/podman-compose -p occupify-be-administration -f docker.be.administration.compose.yml --env-file administration.env down

[Install]
WantedBy=default.target